# 仓库内统一使用 LF，避免 Windows/Linux 协作时的整文件 diff 噪音
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.jar binary

# 这些文件在 Windows 上必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf

# 生成的 lock 文件不参与 diff，避免冲突时被当成代码冲突
pnpm-lock.yaml linguist-generated=true
